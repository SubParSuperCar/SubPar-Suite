<mah:MetroWindow x:Class="SubPar_Suite.MainWindow"
				 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
				 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
				 xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
				 xmlns:li="clr-namespace:LoadingIndicators.WPF;assembly=LoadingIndicators.WPF"
				 Title="SubPar Suite"
				 Icon="/Icon.ico"
				 Width="500" Height="400"
				 MinWidth="375" MinHeight="300"
				 ResizeMode="CanResizeWithGrip"
				 WindowStartupLocation="CenterScreen"
				 SaveWindowPosition="True"
				 GlowBrush="{DynamicResource MahApps.Brushes.Accent}">

	<mah:MetroWindow.TitleTemplate>
		<DataTemplate>
			<TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=mah:MetroWindow}}"
					   FontFamily="Segoe UI Semibold"
					   FontSize="16"
					   TextTrimming="CharacterEllipsis"
					   HorizontalAlignment="Center"
					   VerticalAlignment="Center" />
		</DataTemplate>
	</mah:MetroWindow.TitleTemplate>

	<mah:MetroWindow.IconTemplate>
		<DataTemplate>
			<Image Source="{Binding}"
				   ToolTip="Open System Menu"
				   Width="24" Height="24"
				   HorizontalAlignment="Center"
				   VerticalAlignment="Center"
				   RenderOptions.BitmapScalingMode="HighQuality">
				
				<Image.Effect>
					<DropShadowEffect Color="#FFC0E0FF"
									  BlurRadius="4"
									  ShadowDepth="0"
									  Opacity="1" />
				</Image.Effect>
			</Image>
		</DataTemplate>
	</mah:MetroWindow.IconTemplate>

	<mah:MetroWindow.WindowButtonCommands>
		<mah:WindowButtonCommands Template="{StaticResource MahApps.Templates.WindowButtonCommands}" />
	</mah:MetroWindow.WindowButtonCommands>

	<mah:MetroWindow.LeftWindowCommands>
		<mah:WindowCommands>
			<Button ToolTip="Show Info Dialog">
				<ico:PackIconMaterial Kind="InformationSlabBoxOutline"
									  Width="16" Height="16" />
			</Button>
		</mah:WindowCommands>
	</mah:MetroWindow.LeftWindowCommands>

	<mah:MetroWindow.RightWindowCommands>
		<mah:WindowCommands>
			<Button ToolTip="Mask Content">
				<ico:PackIconMaterial Kind="EyeOffOutline"
									  Width="16" Height="16" />
			</Button>

			<Button ToolTip="Open Log File">
				<ico:PackIconMaterial Kind="TextBoxEditOutline"
									  Width="16" Height="16" />
			</Button>

			<Button ToolTip="Open Settings Page">
				<ico:PackIconMaterial Kind="CogOutline"
									  Width="16" Height="16" />
			</Button>
		</mah:WindowCommands>
	</mah:MetroWindow.RightWindowCommands>

	<Grid>
		<mah:MetroAnimatedSingleRowTabControl
				x:Name="ShaderInput"
				ItemsSource="{Binding Pages}"
				SelectedItem="{Binding SelectedPage}"
				Style="{DynamicResource MahApps.Styles.TabControl.AnimatedSingleRow}"
				mah:TabControlHelper.Underlined="TabPanel">

			<mah:MetroAnimatedSingleRowTabControl.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding PageName}" />
				</DataTemplate>
			</mah:MetroAnimatedSingleRowTabControl.ItemTemplate>

			<mah:MetroAnimatedSingleRowTabControl.ContentTemplate>
				<DataTemplate>
					<mah:TransitioningContentControl
						Content="{Binding PageInstance}"
						Focusable="False" />
				</DataTemplate>
			</mah:MetroAnimatedSingleRowTabControl.ContentTemplate>
		</mah:MetroAnimatedSingleRowTabControl>

		<Image x:Name="ShaderOutput"
			   IsHitTestVisible="False"
			   Stretch="Fill" />
	</Grid>

</mah:MetroWindow>
